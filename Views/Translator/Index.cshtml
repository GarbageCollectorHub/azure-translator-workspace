@using TranslatorAzure.Models.Translator
@inject Microsoft.Extensions.Options.IOptions<TranslatorAzure.Services.FileText.FileTextImportOptions> FileTextOptions
@model TranslatorAzure.Models.Translator.TranslatorViewModel

@{
    ViewData["Title"] = "Azure Translator";

    const string autoCode = TranslatorFormModel.AutoDetectLanguageCode;
    string selectedFrom = Model.FormModel?.LanguageFrom ?? autoCode;
    string selectedTo = Model.FormModel?.LanguageTo ?? "uk";
    string sourceText = string.IsNullOrWhiteSpace(Model.FormModel?.Text)
        ? "Hello, how are you today?"
        : Model.FormModel.Text;

    string workspaceSampleText = @"Garbage collection in .NET

Every object created in managed code is tracked by the CLR garbage collector. Most ordinary allocations begin on the small object heap; very large objects use the large object heap, and explicitly pinned allocations can use the pinned object heap. These are different allocation regions, not different ownership rules: the collector still determines whether each managed object can be reached by the application.

Creating a small object is intentionally cheap. The runtime normally advances an allocation pointer instead of searching for a suitable free block. That makes allocation fast, but the heap must occasionally be collected before more space can be reserved.

A collection begins with roots: local variables on thread stacks, static fields, CPU registers, and runtime handles. The runtime follows references from those roots. Every object it can reach is live; an object outside that graph is garbage and its memory can be reused.

New allocations start in generation 0 because most objects are short-lived. Survivors can be promoted to generation 1 and then generation 2. Collecting a young generation examines a smaller part of the heap, while a generation 2 collection is broader and normally more expensive.

After a collection, movable live objects can be compacted into a contiguous block, and the runtime updates the references to them. Pinned objects cannot move, so long-lived pinning can make compaction less effective.

GC releases managed memory. It does not close file handles, database connections, or network streams; those resources still need deterministic cleanup through IDisposable and using.";

    var sourceLanguageInfo = selectedFrom == autoCode
        ? null
        : Model.TranslatorLanguages.translation.GetValueOrDefault(selectedFrom);
    var targetLanguageInfo = Model.TranslatorLanguages.translation.GetValueOrDefault(selectedTo);

    string textDirectionFrom = sourceLanguageInfo?.dir ?? "ltr";
    string textDirectionTo = targetLanguageInfo?.dir ?? "ltr";

    string LanguageLabel(KeyValuePair<string, LanguageInfo> language)
    {
        var info = language.Value;
        return info.name == info.nativeName
            ? info.name
            : $"{info.name} ({info.nativeName})";
    }

    var maxUploadBytes = FileTextOptions.Value.MaxUploadBytes;
    var maxUploadSizeLabel = FileTextOptions.Value.MaxUploadSizeLabel;
}

<section class="translator-shell">
    <h1 class="visually-hidden">Azure Translator</h1>

    <form id="translator-form" class="translation-surface" method="get" asp-controller="Translator" asp-action="Index">
        @Html.AntiForgeryToken()
        <input type="hidden" id="submit-action" name="btn" value="translate" />
        <input type="hidden" name="detected-lang" value="@Model.DetectedLanguage" />
        <div class="translator-grid">
            <div class="translator-pane">
                <label class="form-label" for="source-language">Source</label>
                <select id="source-language" name="lang-from" class="form-select" aria-label="Source language">
                    <option value="@autoCode" selected="@(selectedFrom == autoCode ? "selected" : null)">Auto-detect</option>
                    @foreach (var lang in Model.TranslatorLanguages.translation)
                    {
                        var textDirectionClass = lang.Value.dir == "ltr" ? "ltr-text" : "rtl-text";

                        <option
                            value="@lang.Key"
                            class="@textDirectionClass"
                            selected="@(lang.Key == selectedFrom ? "selected" : null)">
                            @LanguageLabel(lang)
                        </option>
                    }
                </select>

                <textarea
                    id="source-text"
                    name="text"
                    class="form-control translator-textarea @(textDirectionFrom == "ltr" ? "ltr-text" : "rtl-text")"
                    rows="7">@sourceText</textarea>

                <div class="translator-meta">
                    @if (Model.DetectedLanguage != null)
                    {
                        <span>
                            Detected:
                            @Model.DetectedLanguage
                            @if (Model.DetectionScore != null)
                            {
                                <span>(@Math.Round(Model.DetectionScore.Value * 100)%)</span>
                            }
                        </span>
                    }
                    @if (Model.TransliterationFrom != null)
                    {
                        <span title="Transliteration">[@Model.TransliterationFrom]</span>
                    }
                </div>
            </div>

            <div class="translator-actions">
                <button
                    class="btn btn-outline-secondary icon-button"
                    type="submit"
                    data-submit-action="switch"
                    title="Switch languages"
                    aria-label="Switch languages">
                    <i class="bi bi-arrow-left-right"></i>
                </button>
                <button
                    id="translate-button"
                    class="btn btn-primary icon-button translate-button"
                    type="submit"
                    data-submit-action="translate"
                    title="Translate"
                    aria-label="Translate">
                    <i class="bi bi-translate"></i>
                </button>
            </div>

            <div class="translator-pane">
                <label class="form-label" for="target-language">Target</label>
                <select id="target-language" name="lang-to" class="form-select" aria-label="Target language">
                    @foreach (var lang in Model.TranslatorLanguages.translation)
                    {
                        var textDirectionClass = lang.Value.dir == "ltr" ? "ltr-text" : "rtl-text";

                        <option
                            value="@lang.Key"
                            class="@textDirectionClass"
                            selected="@(lang.Key == selectedTo ? "selected" : null)">
                            @LanguageLabel(lang)
                        </option>
                    }
                </select>

                <div class="translation-output">
                    <textarea
                        id="translated-text"
                        name="translation"
                        class="form-control translator-textarea @(textDirectionTo == "ltr" ? "ltr-text" : "rtl-text")"
                        rows="7"
                        placeholder="Translation will appear here"
                        readonly>@Model.Translation</textarea>
                    <button
                        id="copy-translation"
                        class="btn btn-outline-secondary icon-button copy-button"
                        type="button"
                        title="Copy translation"
                        aria-label="Copy translation">
                        <i class="bi bi-copy"></i>
                    </button>
                </div>

                <div class="translator-meta">
                    @if (Model.ErrorMessage != null)
                    {
                        <span class="translator-error">
                            <i class="bi bi-exclamation-circle"></i>
                            @Model.ErrorMessage
                        </span>
                    }
                    @if (Model.TransliterationTo != null)
                    {
                        <span title="Transliteration">[@Model.TransliterationTo]</span>
                    }
                </div>
            </div>
        </div>
    </form>

    <div class="workspace-grid">
        <section class="document-panel" aria-label="Text workspace">
            <div class="panel-toolbar">
                <div class="workspace-tabs" role="tablist" aria-label="Workspace type">
                    <button class="workspace-tab is-active" type="button" role="tab" aria-selected="true" data-workspace-tab="sample">Text editor</button>
                    <button class="workspace-tab" type="button" role="tab" aria-selected="false" data-workspace-tab="file">Imported file</button>
                </div>

                <div class="panel-controls" aria-label="Editor controls">
                    <div class="toolbar-group">
                        <button id="paste-text" class="btn toolbar-command-button" type="button" title="Paste text from clipboard" aria-label="Paste text from clipboard">
                            <i class="bi bi-clipboard-plus"></i>
                            <span>Paste</span>
                        </button>
                        <button id="clear-text" class="btn toolbar-command-button" type="button" title="Clear current text" aria-label="Clear current text">
                            <i class="bi bi-eraser"></i>
                            <span>Clear</span>
                        </button>
                    </div>
                    <div class="toolbar-group toolbar-group--selection">
                        <label class="toolbar-toggle" for="translate-selected">
                            <input type="checkbox" id="translate-selected" checked>
                            <span>Translate selection</span>
                        </label>
                        <label class="toolbar-toggle" for="replace-selected">
                            <input type="checkbox" id="replace-selected">
                            <span>Replace selection</span>
                        </label>
                    </div>
                    <div class="toolbar-group toolbar-group--actions" aria-label="Text actions">
                        <button id="select-all-text" class="btn toolbar-command-button" type="button" title="Select all text in the current section" aria-label="Select all text in the current section">
                            <i class="bi bi-text-paragraph"></i>
                            <span>Select all</span>
                        </button>
                        <div class="toolbar-icon-cluster" role="group" aria-label="Replacement history">
                            <button id="undo-replacement" class="btn toolbar-icon-button" type="button" title="Undo replacement (Ctrl+Z)" aria-label="Undo replacement" disabled>
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button id="redo-replacement" class="btn toolbar-icon-button" type="button" title="Redo replacement (Ctrl+Y)" aria-label="Redo replacement" disabled>
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <button id="reset-sample" class="btn toolbar-command-button toolbar-command-button--restore" type="button" title="Restore the default example text" aria-label="Restore the default example text">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>Restore text</span>
                        </button>
                    </div>
                </div>
                <span id="selection-status" class="selection-status" role="status"></span>
            </div>

            <div id="sample-workspace" class="workspace-content">
                <textarea id="sample-text" class="document-textarea" spellcheck="true" placeholder="Write or paste text here">@workspaceSampleText</textarea>
                <p class="editor-helper"><i class="bi bi-pencil-square" aria-hidden="true"></i>Type or paste your own text here.</p>
            </div>

            <div id="file-workspace" class="workspace-content" hidden>
                <div id="file-upload" class="file-upload">
                    <label id="file-drop-zone" class="file-drop-zone">
                        <input id="file-input" class="visually-hidden" type="file" accept=".txt,.docx,.pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/pdf" />
                        <span class="file-upload-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                        <strong>Choose or drop a file</strong>
                        <span class="file-upload-types">TXT, DOCX, PDF - up to @maxUploadSizeLabel</span>
                        <span class="file-upload-note">PDF: selectable text only. Scans and image-only files are not supported.</span>
                    </label>
                    <div class="file-selection-row">
                        <span id="file-selection-name" class="file-selection-name" hidden></span>
                        <button id="import-file" class="btn btn-primary" type="button" disabled>
                            <i class="bi bi-file-earmark-text me-2"></i>Open text
                        </button>
                    </div>
                </div>

                <div id="file-editor" class="file-editor" hidden>
                    <div class="file-editor-header">
                        <span id="imported-file-name" class="imported-file-name"></span>
                        <div class="file-editor-actions">
                            <div id="file-view-toggle" class="file-view-toggle" role="tablist" aria-label="PDF view" hidden>
                                <button class="file-view-button is-active" type="button" role="tab" aria-selected="true" data-file-view="text">Text</button>
                                <button class="file-view-button" type="button" role="tab" aria-selected="false" data-file-view="preview">Original PDF</button>
                                <button class="file-view-button file-view-button--split" type="button" role="tab" aria-selected="false" data-file-view="split" title="Show text and the original PDF side by side">Split</button>
                            </div>
                            <div class="file-segment-navigation" aria-label="File section navigation">
                                <button id="previous-segment" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Previous section" aria-label="Previous section">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span id="segment-position"></span>
                                <button id="next-segment" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Next section" aria-label="Next section">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <button id="clear-file" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Close imported file" aria-label="Close imported file">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="file-editor-body">
                        <textarea id="file-text" class="document-textarea" spellcheck="true"></textarea>
                        <div id="pdf-preview" class="pdf-preview" hidden>
                            <div class="pdf-preview-toolbar">
                                <div class="pdf-page-navigation" aria-label="PDF page navigation">
                                    <button id="previous-pdf-page" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Previous PDF page" aria-label="Previous PDF page">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                    <span id="pdf-page-position">Page 1</span>
                                    <button id="next-pdf-page" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Next PDF page" aria-label="Next PDF page">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>
                                <span id="pdf-preview-status" class="pdf-preview-status" role="status"></span>
                            </div>
                            <div id="pdf-canvas-shell" class="pdf-canvas-shell">
                                <div id="pdf-page-stage" class="pdf-page-stage">
                                    <canvas id="pdf-canvas"></canvas>
                                    <div id="pdf-text-layer" class="pdf-text-layer textLayer" aria-label="Selectable text in PDF preview"></div>
                                </div>
                            </div>
                            <div id="pdf-selection-popover" class="pdf-selection-popover" role="dialog" aria-label="Selected PDF text" hidden>
                                <div class="pdf-selection-actions" role="toolbar" aria-label="Selected text actions">
                                    <button id="translate-pdf-selection" class="btn btn-primary pdf-selection-translate" type="button">
                                        <i class="bi bi-translate" aria-hidden="true"></i>
                                        <span>Translate</span>
                                    </button>
                                    <button id="copy-pdf-selection" class="btn toolbar-icon-button" type="button" title="Copy selected text" aria-label="Copy selected text">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                    <button id="close-pdf-selection" class="btn toolbar-icon-button" type="button" title="Close selected text actions" aria-label="Close selected text actions">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <p id="pdf-selection-result" class="pdf-selection-result" role="status" hidden></p>
                            </div>
                            <p class="pdf-preview-note"><i class="bi bi-info-circle" aria-hidden="true"></i>Preview keeps the original layout and images. Text selection and translation work only where the PDF contains selectable text.</p>
                        </div>
                    </div>
                </div>

                <p id="file-import-message" class="file-import-message" role="status" hidden></p>
            </div>
            <div id="workspace-resize-handle" class="workspace-resize-handle" role="separator" aria-label="Resize workspace height" aria-orientation="horizontal" tabindex="0">
                <span aria-hidden="true"></span>
            </div>
        </section>

        <aside id="history-panel" class="history-panel" aria-label="Translation history" hidden>
            <div class="history-header">
                <h2>History</h2>
                <div class="history-actions">
                    <button id="clear-history" class="btn toolbar-icon-button" type="button" title="Clear history" aria-label="Clear history">
                        <i class="bi bi-trash3"></i>
                    </button>
                    <button id="history-close" class="btn toolbar-icon-button" type="button" title="Close history" aria-label="Close history">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div id="translation-history" class="history-list"></div>
        </aside>
    </div>
</section>

<div class="position-fixed top-0 start-50 translate-middle-x mt-4" style="z-index: 1100">
    <div id="translation-toast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <span class="translate-icon me-2"><i class="bi bi-globe2"></i></span>
            <strong class="me-auto">Translation</strong>
            <small class="text-muted" id="toast-time"></small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="toast-body"></div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const historyKey = 'azure-translator-history-v1';
            const historyLimit = 20;
            const maxSelectionLength = @TranslationRequest.MaxTextLength;
            const maxUploadBytes = @maxUploadBytes;
            const maxUploadSizeLabel = '@maxUploadSizeLabel';
            const translateEndpoint = '@Url.Action("Translate", "Translator")';
            const fileImportEndpoint = '@Url.Action("Import", "FileText")';
            const pdfJsModuleUrl = '@Url.Content("~/lib/pdfjs/pdf.min.mjs")';
            const pdfWorkerUrl = '@Url.Content("~/lib/pdfjs/pdf.worker.min.mjs")';
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            const form = document.getElementById('translator-form');
            const submitAction = document.getElementById('submit-action');
            const translateButton = document.getElementById('translate-button');
            const sourceLanguage = document.getElementById('source-language');
            const targetLanguage = document.getElementById('target-language');
            const sampleText = document.getElementById('sample-text');
            const fileText = document.getElementById('file-text');
            const defaultSampleText = sampleText.value;
            const translateSelected = document.getElementById('translate-selected');
            const replaceSelected = document.getElementById('replace-selected');
            const pasteText = document.getElementById('paste-text');
            const clearText = document.getElementById('clear-text');
            const selectAllText = document.getElementById('select-all-text');
            const undoReplacement = document.getElementById('undo-replacement');
            const redoReplacement = document.getElementById('redo-replacement');
            const resetSample = document.getElementById('reset-sample');
            const selectionStatus = document.getElementById('selection-status');
            const workspaceGrid = document.querySelector('.workspace-grid');
            const workspaceResizeHandle = document.getElementById('workspace-resize-handle');
            const historyPanel = document.getElementById('history-panel');
            const historyToggle = document.getElementById('history-toggle');
            const historyClose = document.getElementById('history-close');
            const historyList = document.getElementById('translation-history');
            const clearHistory = document.getElementById('clear-history');
            const translatedText = document.getElementById('translated-text');
            const copyTranslation = document.getElementById('copy-translation');
            const fileInput = document.getElementById('file-input');
            const fileSelectionName = document.getElementById('file-selection-name');
            const fileDropZone = document.getElementById('file-drop-zone');
            const importFile = document.getElementById('import-file');
            const fileUpload = document.getElementById('file-upload');
            const fileEditor = document.getElementById('file-editor');
            const fileImportMessage = document.getElementById('file-import-message');
            const importedFileName = document.getElementById('imported-file-name');
            const previousSegment = document.getElementById('previous-segment');
            const nextSegment = document.getElementById('next-segment');
            const segmentPosition = document.getElementById('segment-position');
            const clearFile = document.getElementById('clear-file');
            const fileViewToggle = document.getElementById('file-view-toggle');
            const fileViewButtons = document.querySelectorAll('[data-file-view]');
            const pdfPreview = document.getElementById('pdf-preview');
            const previousPdfPage = document.getElementById('previous-pdf-page');
            const nextPdfPage = document.getElementById('next-pdf-page');
            const pdfPagePosition = document.getElementById('pdf-page-position');
            const pdfPreviewStatus = document.getElementById('pdf-preview-status');
            const pdfCanvasShell = document.getElementById('pdf-canvas-shell');
            const pdfPageStage = document.getElementById('pdf-page-stage');
            const pdfCanvas = document.getElementById('pdf-canvas');
            const pdfTextLayer = document.getElementById('pdf-text-layer');
            const pdfSelectionPopover = document.getElementById('pdf-selection-popover');
            const translatePdfSelectionButton = document.getElementById('translate-pdf-selection');
            const copyPdfSelectionButton = document.getElementById('copy-pdf-selection');
            const closePdfSelectionButton = document.getElementById('close-pdf-selection');
            const pdfSelectionResult = document.getElementById('pdf-selection-result');

            let activeWorkspace = 'sample';
            let selectionTimer = 0;
            let lastSelectionKey = '';
            let importedSegments = [];
            let importedPageCount = null;
            let currentSegmentIndex = 0;
            let selectedFile = null;
            let fileDropDepth = 0;
            let isApplyingProgrammaticTextChange = false;
            let importedPdfFile = null;
            let pdfDocument = null;
            let pdfLoadingTask = null;
            let currentPdfPage = 1;
            let isPdfPreviewActive = false;
            let pdfRenderId = 0;
            let pdfRenderTask = null;
            let pdfResizeTimer = 0;
            let workspaceResizeState = null;
            let pdfJs = null;
            let activePdfSelectionText = '';
            let isPdfPointerSelectionActive = false;
            let pdfPointerSelectionFrame = 0;
            let pdfPointerSelectionPosition = null;
            let pdfPointerSelectionAnchor = null;
            let activePdfSelectionRect = null;

            const replacementHistoryLimit = 20;
            const pdfSelectionPointerTolerance = 48;
            const replacementHistories = new Map();

            const initialInput = @Json.Serialize(Model.FormModel?.Text ?? "");
            const initialOutput = @Json.Serialize(Model.Translation ?? "");

            function loadHistory() {
                try {
                    return JSON.parse(localStorage.getItem(historyKey) || '[]');
                } catch {
                    return [];
                }
            }

            function saveHistory(items) {
                localStorage.setItem(historyKey, JSON.stringify(items.slice(0, historyLimit)));
            }

            function addHistory(input, output, detectedLanguage) {
                if (!input?.trim() || !output?.trim()) {
                    return;
                }

                const item = {
                    input: input.trim(),
                    output: output.trim(),
                    detectedLanguage,
                    time: new Date().toISOString()
                };

                const items = loadHistory()
                    .filter(x => !(x.input === item.input && x.output === item.output));

                items.unshift(item);
                saveHistory(items);
                renderHistory();
            }

            function renderHistory() {
                const items = loadHistory();
                historyList.innerHTML = '';

                if (items.length === 0) {
                    const empty = document.createElement('p');
                    empty.className = 'history-empty';
                    empty.textContent = 'No translations yet';
                    historyList.appendChild(empty);
                    return;
                }

                for (const item of items) {
                    const row = document.createElement('article');
                    row.className = 'history-item';

                    const input = document.createElement('p');
                    input.className = 'history-input';
                    input.textContent = item.input;

                    const output = document.createElement('p');
                    output.className = 'history-output';
                    output.textContent = item.output;

                    const footer = document.createElement('div');
                    footer.className = 'history-footer';

                    const time = document.createElement('span');
                    time.textContent = new Date(item.time).toLocaleString();

                    const copy = document.createElement('button');
                    copy.className = 'btn btn-sm btn-outline-secondary icon-button';
                    copy.type = 'button';
                    copy.title = 'Copy';
                    copy.setAttribute('aria-label', 'Copy');
                    copy.innerHTML = '<i class="bi bi-copy"></i>';
                    copy.addEventListener('click', () => navigator.clipboard?.writeText(item.output));

                    footer.append(time, copy);
                    row.append(input, output, footer);
                    historyList.appendChild(row);
                }
            }

            function showToast(text) {
                const toastEl = document.getElementById('translation-toast');
                document.getElementById('toast-body').textContent = text;
                document.getElementById('toast-time').textContent = new Date().toLocaleTimeString();
                bootstrap.Toast.getOrCreateInstance(toastEl, { autohide: false }).show();
            }

            function activeTextArea() {
                return activeWorkspace === 'file' ? fileText : sampleText;
            }

            function activeReplacementHistoryKey() {
                return activeWorkspace === 'file'
                    ? `file:${currentSegmentIndex}`
                    : 'sample';
            }

            function currentReplacementHistory() {
                const key = activeReplacementHistoryKey();
                if (!replacementHistories.has(key)) {
                    replacementHistories.set(key, { undo: [], redo: [] });
                }

                return replacementHistories.get(key);
            }

            function updateUndoRedoControls() {
                const history = currentReplacementHistory();
                undoReplacement.disabled = history.undo.length === 0;
                redoReplacement.disabled = history.redo.length === 0;
            }

            function syncCurrentFileSegment() {
                const currentSegment = importedSegments[currentSegmentIndex];
                if (activeWorkspace === 'file' && currentSegment) {
                    currentSegment.text = fileText.value;
                }
            }

            function clearCurrentReplacementHistory() {
                replacementHistories.delete(activeReplacementHistoryKey());
                updateUndoRedoControls();
            }

            function clearReplacementHistories() {
                replacementHistories.clear();
                updateUndoRedoControls();
            }

            function recordReplacement(beforeText, afterText) {
                if (beforeText === afterText) {
                    return;
                }

                const history = currentReplacementHistory();
                history.undo.push({ beforeText, afterText });
                if (history.undo.length > replacementHistoryLimit) {
                    history.undo.shift();
                }

                history.redo = [];
                updateUndoRedoControls();
            }

            function applyReplacementHistory(direction) {
                const history = currentReplacementHistory();
                const source = direction === 'undo' ? history.undo : history.redo;
                const target = direction === 'undo' ? history.redo : history.undo;
                const change = source.pop();

                if (!change) {
                    updateUndoRedoControls();
                    return false;
                }

                const textArea = activeTextArea();
                const value = direction === 'undo' ? change.beforeText : change.afterText;

                isApplyingProgrammaticTextChange = true;
                try {
                    textArea.value = value;
                } finally {
                    isApplyingProgrammaticTextChange = false;
                }
                syncCurrentFileSegment();

                const caretPosition = value.length;
                textArea.focus();
                textArea.setSelectionRange(caretPosition, caretPosition);
                target.push(change);
                updateUndoRedoControls();
                resetSelectionState();
                return true;
            }

            function handleWorkspaceTextInput() {
                syncCurrentFileSegment();

                if (!isApplyingProgrammaticTextChange) {
                    clearCurrentReplacementHistory();
                }
            }

            async function pasteFromClipboard() {
                if (!navigator.clipboard?.readText) {
                    setSelectionStatus('Clipboard access is unavailable. Use Ctrl+V.');
                    return;
                }

                try {
                    const pastedText = await navigator.clipboard.readText();
                    if (!pastedText) {
                        return;
                    }

                    const textArea = activeTextArea();
                    const beforeText = textArea.value;
                    const shouldReplaceDefaultSample = activeWorkspace === 'sample'
                        && textArea.value === defaultSampleText
                        && textArea.selectionStart === textArea.selectionEnd;

                    if (shouldReplaceDefaultSample) {
                        textArea.select();
                    }

                    textArea.setRangeText(pastedText, textArea.selectionStart, textArea.selectionEnd, 'end');
                    syncCurrentFileSegment();
                    recordReplacement(beforeText, textArea.value);
                    resetSelectionState();
                    textArea.focus();
                } catch {
                    setSelectionStatus('Clipboard access is unavailable. Use Ctrl+V.');
                }
            }

            function clearCurrentText() {
                const textArea = activeTextArea();
                const beforeText = textArea.value;

                if (!beforeText) {
                    textArea.focus();
                    return;
                }

                textArea.value = '';
                syncCurrentFileSegment();
                recordReplacement(beforeText, '');
                resetSelectionState();
                textArea.focus();
            }

            function setSelectionStatus(message) {
                selectionStatus.textContent = message;
            }

            async function requestTranslation(text) {
                const response = await fetch(translateEndpoint, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify({
                        text,
                        languageFrom: sourceLanguage.value,
                        languageTo: targetLanguage.value
                    })
                });
                const result = await response.json();

                if (!response.ok || !result.status?.isOk) {
                    throw new Error(result.data?.message || result.status?.phrase || 'Translation unavailable');
                }

                const output = result.data?.text ?? '';
                if (!output) {
                    throw new Error('Translation unavailable');
                }

                return {
                    text: output,
                    detectedLanguage: result.data?.detectedLanguage
                };
            }

            async function translateSelection(force = false) {
                const textArea = activeTextArea();
                if (!translateSelected.checked || (!force && document.activeElement !== textArea)) {
                    return;
                }

                const start = textArea.selectionStart;
                const end = textArea.selectionEnd;
                const selection = textArea.value.substring(start, end);
                const selectedText = selection.trim();

                if (selectedText.length < 2) {
                    return;
                }

                if (selectedText.length > maxSelectionLength) {
                    setSelectionStatus(`Select up to ${maxSelectionLength.toLocaleString()} characters at a time.`);
                    return;
                }

                const selectionKey = `${activeWorkspace}:${start}:${end}:${selectedText}:${sourceLanguage.value}:${targetLanguage.value}:${replaceSelected.checked}`;
                if (selectionKey === lastSelectionKey) {
                    return;
                }
                lastSelectionKey = selectionKey;

                setSelectionStatus('Translating...');

                try {
                    const result = await requestTranslation(selectedText);
                    const output = result.text;

                    if (replaceSelected.checked) {
                        const beforeText = textArea.value;
                        const leadingWhitespace = selection.match(/^\s*/)?.[0] ?? '';
                        const trailingWhitespace = selection.match(/\s*$/)?.[0] ?? '';
                        isApplyingProgrammaticTextChange = true;
                        try {
                            textArea.setRangeText(`${leadingWhitespace}${output}${trailingWhitespace}`, start, end, 'end');
                        } finally {
                            isApplyingProgrammaticTextChange = false;
                        }
                        syncCurrentFileSegment();
                        recordReplacement(beforeText, textArea.value);
                    } else {
                        showToast(output);
                    }

                    addHistory(selectedText, output, result.detectedLanguage);
                    setSelectionStatus('');
                } catch (error) {
                    setSelectionStatus(error instanceof Error ? error.message : 'Translation unavailable');
                }
            }

            function scheduleSelectionTranslation() {
                clearTimeout(selectionTimer);
                selectionTimer = window.setTimeout(() => translateSelection(), 650);
            }

            function resetSelectionState() {
                lastSelectionKey = '';
                setSelectionStatus('');
            }

            function setActiveWorkspace(workspace) {
                activeWorkspace = workspace;
                document.getElementById('sample-workspace').hidden = workspace !== 'sample';
                document.getElementById('file-workspace').hidden = workspace !== 'file';
                resetSample.hidden = workspace !== 'sample';

                document.querySelectorAll('[data-workspace-tab]').forEach(button => {
                    const isActive = button.dataset.workspaceTab === workspace;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-selected', String(isActive));
                });

                resetSelectionState();
                updateUndoRedoControls();
            }

            function setHistoryOpen(isOpen) {
                historyPanel.hidden = !isOpen;
                workspaceGrid.classList.toggle('is-history-open', isOpen);
                historyToggle.setAttribute('aria-expanded', String(isOpen));

                window.requestAnimationFrame(() => {
                    if (fileEditor.classList.contains('is-split-view') && !canUseSplitFileView()) {
                        setFileView('text');
                    }
                });
            }

            function showFileImportMessage(message, isError = false) {
                fileImportMessage.textContent = message;
                fileImportMessage.hidden = !message;
                fileImportMessage.classList.toggle('is-error', Boolean(message) && isError);
            }

            function renderCurrentSegment() {
                const segment = importedSegments[currentSegmentIndex];
                if (!segment) {
                    return;
                }

                fileText.value = segment.text;
                if (Number.isInteger(segment.sourcePage)) {
                    const pageCountSuffix = Number.isInteger(importedPageCount)
                        ? ` of ${importedPageCount}`
                        : '';
                    const partSuffix = segment.partCount > 1
                        ? `, part ${segment.partNumber} of ${segment.partCount}`
                        : '';
                    segmentPosition.textContent = `Page ${segment.sourcePage}${pageCountSuffix}${partSuffix}`;
                } else {
                    segmentPosition.textContent = `Section ${currentSegmentIndex + 1} of ${importedSegments.length}`;
                }
                previousSegment.disabled = currentSegmentIndex === 0;
                nextSegment.disabled = currentSegmentIndex === importedSegments.length - 1;
                resetSelectionState();
                updateUndoRedoControls();

                if (isPdfPreviewActive && Number.isInteger(segment.sourcePage)) {
                    void renderPdfPage(segment.sourcePage);
                }
            }

            function resetPendingFile() {
                selectedFile = null;
                fileInput.value = '';
                fileSelectionName.textContent = '';
                fileSelectionName.hidden = true;
                importFile.disabled = true;
            }

            function getFileExtension(fileName) {
                const separator = fileName.lastIndexOf('.');
                return separator === -1 ? '' : fileName.substring(separator + 1).toLowerCase();
            }

            function isPdfFile(file) {
                return getFileExtension(file?.name ?? '') === 'pdf';
            }

            function setFileView(view) {
                const canSplitFileView = canUseSplitFileView();
                const selectedView = view === 'split' && !canSplitFileView ? 'text' : view;
                const shouldShowPreview = (selectedView === 'preview' || selectedView === 'split') && importedPdfFile !== null;
                const shouldShowSplit = selectedView === 'split' && shouldShowPreview;
                isPdfPreviewActive = shouldShowPreview;
                fileEditor.classList.toggle('is-split-view', shouldShowSplit);
                fileText.hidden = shouldShowPreview && !shouldShowSplit;
                pdfPreview.hidden = !shouldShowPreview;

                fileViewButtons.forEach(button => {
                    const isActive = button.dataset.fileView === (shouldShowPreview ? selectedView : 'text');
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-selected', String(isActive));
                });

                if (shouldShowPreview) {
                    const segment = importedSegments[currentSegmentIndex];
                    void renderPdfPage(segment?.sourcePage ?? currentPdfPage);
                }
            }

            function canUseSplitFileView() {
                return window.matchMedia('(min-width: 1200px)').matches && fileEditor.clientWidth >= 980;
            }

            function resetPdfPreview() {
                pdfRenderId++;
                hidePdfSelectionPopover();

                try {
                    pdfRenderTask?.cancel();
                } catch {
                    // The render task may already be complete.
                }

                try {
                    pdfLoadingTask?.destroy();
                } catch {
                    // The loading task may already be settled.
                }

                try {
                    pdfDocument?.destroy();
                } catch {
                    // The document may already be released.
                }

                importedPdfFile = null;
                pdfDocument = null;
                pdfLoadingTask = null;
                pdfRenderTask = null;
                currentPdfPage = 1;
                isPdfPreviewActive = false;
                pdfPreview.hidden = true;
                pdfPreviewStatus.textContent = '';
                pdfPagePosition.textContent = 'Page 1';
                previousPdfPage.disabled = true;
                nextPdfPage.disabled = true;
                pdfCanvas.width = 0;
                pdfCanvas.height = 0;
                pdfCanvas.style.width = '';
                pdfCanvas.style.height = '';
                pdfPageStage.style.width = '';
                pdfPageStage.style.height = '';
                pdfTextLayer.replaceChildren();
            }

            async function loadPdfJs() {
                if (!pdfJs) {
                    pdfJs = await import(pdfJsModuleUrl);
                    pdfJs.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;
                }

                return pdfJs;
            }

            async function loadPdfDocument() {
                if (pdfDocument) {
                    return pdfDocument;
                }

                if (!importedPdfFile) {
                    return null;
                }

                try {
                    const pdfjs = await loadPdfJs();
                    const fileData = new Uint8Array(await importedPdfFile.arrayBuffer());
                    pdfLoadingTask = pdfjs.getDocument({ data: fileData });
                    pdfDocument = await pdfLoadingTask.promise;
                    return pdfDocument;
                } catch {
                    pdfPreviewStatus.textContent = 'Preview is unavailable for this PDF.';
                    return null;
                }
            }

            function isPdfTextNode(node) {
                const element = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
                return Boolean(element && pdfTextLayer.contains(element));
            }

            function getPdfTextSpan(node) {
                const element = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
                return element?.closest?.('.pdf-text-layer span:not(.markedContent)') ?? null;
            }

            function beginPdfPointerSelection(event) {
                if (event.button !== 0) {
                    return;
                }

                const anchorSpan = getPdfTextSpan(event.target)
                    ?? findClosestPdfTextSpan(event.clientX, event.clientY);
                const anchorNode = anchorSpan?.firstChild;
                const selection = window.getSelection();

                if (!anchorNode || !selection || typeof selection.setBaseAndExtent !== 'function') {
                    isPdfPointerSelectionActive = false;
                    pdfPointerSelectionAnchor = null;
                    return;
                }

                // PDF.js spans have gaps between glyphs. Anchor the drag to the nearest text span
                // so a small miss beside a line cannot reuse an old browser selection range.
                event.preventDefault();
                isPdfPointerSelectionActive = true;
                pdfPointerSelectionAnchor = {
                    node: anchorNode,
                    offset: getPdfTextOffsetAtPointer(anchorSpan, event.clientX, event.clientY)
                };
                selection.removeAllRanges();
                selection.setBaseAndExtent(
                    pdfPointerSelectionAnchor.node,
                    pdfPointerSelectionAnchor.offset,
                    pdfPointerSelectionAnchor.node,
                    pdfPointerSelectionAnchor.offset);
                hidePdfSelectionPopover();
            }

            function distanceToPdfTextRect(rect, clientX, clientY) {
                const horizontalDistance = Math.max(rect.left - clientX, 0, clientX - rect.right);
                const verticalDistance = Math.max(rect.top - clientY, 0, clientY - rect.bottom);
                return Math.hypot(horizontalDistance, verticalDistance);
            }

            function findClosestPdfTextSpan(clientX, clientY) {
                let closest = null;

                for (const span of pdfTextLayer.querySelectorAll('span:not(.markedContent)')) {
                    if (!span.textContent?.trim()) {
                        continue;
                    }

                    const distance = distanceToPdfTextRect(span.getBoundingClientRect(), clientX, clientY);
                    if (!closest || distance < closest.distance) {
                        closest = { span, distance };
                    }
                }

                return closest?.distance <= pdfSelectionPointerTolerance ? closest.span : null;
            }

            function getPdfTextOffsetAtPointer(span, clientX, clientY) {
                const caretPosition = document.caretPositionFromPoint?.(clientX, clientY);
                if (caretPosition?.offsetNode && span.contains(caretPosition.offsetNode)) {
                    return caretPosition.offset;
                }

                const caretRange = document.caretRangeFromPoint?.(clientX, clientY);
                if (caretRange?.startContainer && span.contains(caretRange.startContainer)) {
                    return caretRange.startOffset;
                }

                const rect = span.getBoundingClientRect();
                return clientX < rect.left + rect.width / 2 ? 0 : span.textContent.length;
            }

            function normalisePdfSelectionEndpoint(event) {
                if (!isPdfPointerSelectionActive || !pdfPointerSelectionAnchor) {
                    return false;
                }

                const selection = window.getSelection();
                if (!selection || typeof selection.setBaseAndExtent !== 'function') {
                    return false;
                }

                const endpointSpan = findClosestPdfTextSpan(event.clientX, event.clientY);
                const endpointNode = endpointSpan?.firstChild;
                if (!endpointNode) {
                    return false;
                }

                selection.setBaseAndExtent(
                    pdfPointerSelectionAnchor.node,
                    pdfPointerSelectionAnchor.offset,
                    endpointNode,
                    getPdfTextOffsetAtPointer(endpointSpan, event.clientX, event.clientY));
                return true;
            }

            function updatePdfPointerSelection(event) {
                if (!isPdfPointerSelectionActive || (event.buttons & 1) === 0) {
                    return;
                }

                pdfPointerSelectionPosition = {
                    clientX: event.clientX,
                    clientY: event.clientY
                };

                if (pdfPointerSelectionFrame) {
                    return;
                }

                pdfPointerSelectionFrame = window.requestAnimationFrame(() => {
                    pdfPointerSelectionFrame = 0;

                    if (!isPdfPointerSelectionActive || !pdfPointerSelectionPosition) {
                        return;
                    }

                    // Browser selection can fall through absolutely positioned PDF spans into distant DOM text.
                    // Keep the endpoint beside the actual pointer while the user is dragging.
                    normalisePdfSelectionEndpoint(pdfPointerSelectionPosition);
                });
            }

            function finishPdfPointerSelection(event) {
                const releasedInsidePopover = pdfSelectionPopover.contains(event.target);
                const didNormalise = normalisePdfSelectionEndpoint(event);
                isPdfPointerSelectionActive = false;
                pdfPointerSelectionPosition = null;
                pdfPointerSelectionAnchor = null;

                if (pdfPointerSelectionFrame) {
                    window.cancelAnimationFrame(pdfPointerSelectionFrame);
                    pdfPointerSelectionFrame = 0;
                }

                if (!releasedInsidePopover && (didNormalise || getPdfTextSelection())) {
                    schedulePdfSelectionPopover();
                }
            }

            function getPdfTextSelection() {
                const selection = window.getSelection();
                if (!selection || selection.isCollapsed || selection.rangeCount === 0
                    || !isPdfTextNode(selection.anchorNode) || !isPdfTextNode(selection.focusNode)) {
                    return null;
                }

                const text = selection.toString().replace(/\s+/g, ' ').trim();
                if (text.length < 2) {
                    return null;
                }

                const range = selection.getRangeAt(0);
                const rect = Array.from(range.getClientRects()).find(candidate => candidate.width > 0 && candidate.height > 0)
                    ?? range.getBoundingClientRect();

                return rect.width > 0 && rect.height > 0 ? { text, rect } : null;
            }

            function hidePdfSelectionPopover(clearBrowserSelection = false) {
                activePdfSelectionText = '';
                activePdfSelectionRect = null;
                pdfSelectionPopover.hidden = true;
                pdfSelectionResult.hidden = true;
                pdfSelectionResult.textContent = '';

                if (clearBrowserSelection) {
                    window.getSelection()?.removeAllRanges();
                }
            }

            function showPdfSelectionPopover(selection) {
                activePdfSelectionText = selection.text;
                activePdfSelectionRect = selection.rect;
                pdfSelectionResult.hidden = true;
                pdfSelectionResult.textContent = '';
                pdfSelectionPopover.hidden = false;

                positionPdfSelectionPopover();
            }

            function positionPdfSelectionPopover() {
                if (!activePdfSelectionRect || pdfSelectionPopover.hidden) {
                    return;
                }

                const margin = 12;
                const preferredTop = activePdfSelectionRect.bottom + 10;
                const maxLeft = window.innerWidth - pdfSelectionPopover.offsetWidth - margin;
                const maxTop = window.innerHeight - pdfSelectionPopover.offsetHeight - margin;
                const topAbove = activePdfSelectionRect.top - pdfSelectionPopover.offsetHeight - 10;
                const left = Math.max(margin, Math.min(activePdfSelectionRect.left, maxLeft));
                const top = preferredTop <= maxTop
                    ? preferredTop
                    : Math.max(margin, topAbove);

                pdfSelectionPopover.style.left = `${left}px`;
                pdfSelectionPopover.style.top = `${top}px`;
            }

            function schedulePdfSelectionPopover() {
                window.setTimeout(() => {
                    const selection = getPdfTextSelection();
                    if (!selection) {
                        hidePdfSelectionPopover();
                        return;
                    }

                    if (selection.text.length > maxSelectionLength) {
                        hidePdfSelectionPopover();
                        pdfPreviewStatus.textContent = `Select up to ${maxSelectionLength.toLocaleString()} characters at a time.`;
                        return;
                    }

                    pdfPreviewStatus.textContent = '';
                    showPdfSelectionPopover(selection);
                }, 0);
            }

            async function copyText(text) {
                if (!text) {
                    return false;
                }

                try {
                    if (!navigator.clipboard?.writeText) {
                        throw new Error('Clipboard API is unavailable.');
                    }

                    await navigator.clipboard.writeText(text);
                    return true;
                } catch {
                    const fallback = document.createElement('textarea');
                    fallback.value = text;
                    fallback.setAttribute('readonly', '');
                    fallback.style.position = 'fixed';
                    fallback.style.opacity = '0';
                    document.body.appendChild(fallback);
                    fallback.select();
                    const copied = document.execCommand('copy');
                    fallback.remove();
                    return copied;
                }
            }

            async function translatePdfSelection() {
                if (!activePdfSelectionText || activePdfSelectionText.length > maxSelectionLength) {
                    return;
                }

                translatePdfSelectionButton.disabled = true;
                pdfSelectionResult.hidden = false;
                pdfSelectionResult.textContent = 'Translating...';
                positionPdfSelectionPopover();

                try {
                    const result = await requestTranslation(activePdfSelectionText);
                    pdfSelectionResult.textContent = result.text;
                    addHistory(activePdfSelectionText, result.text, result.detectedLanguage);
                } catch (error) {
                    pdfSelectionResult.textContent = error instanceof Error ? error.message : 'Translation unavailable';
                } finally {
                    translatePdfSelectionButton.disabled = false;
                    positionPdfSelectionPopover();
                }
            }

            async function renderPdfTextLayer(page, viewport, renderId) {
                pdfTextLayer.replaceChildren();
                const textContent = await page.getTextContent();

                if (renderId !== pdfRenderId) {
                    return false;
                }

                if (!textContent.items.some(item => item.str?.trim())) {
                    pdfPreviewStatus.textContent = 'No selectable text found on this page.';
                    return false;
                }

                const pdfjs = await loadPdfJs();
                const textLayer = new pdfjs.TextLayer({
                    textContentSource: textContent,
                    container: pdfTextLayer,
                    viewport
                });
                await textLayer.render();
                return renderId === pdfRenderId;
            }

            async function renderPdfPage(pageNumber) {
                if (!isPdfPreviewActive) {
                    return;
                }

                const renderId = ++pdfRenderId;
                try {
                    pdfRenderTask?.cancel();
                } catch {
                    // The render task may already be complete.
                }
                pdfPreviewStatus.textContent = 'Loading preview...';
                const documentProxy = await loadPdfDocument();
                if (!documentProxy || renderId !== pdfRenderId) {
                    return;
                }

                const normalisedPage = Math.min(Math.max(Number(pageNumber) || 1, 1), documentProxy.numPages);

                try {
                    const page = await documentProxy.getPage(normalisedPage);
                    if (renderId !== pdfRenderId) {
                        return;
                    }

                    const baseViewport = page.getViewport({ scale: 1 });
                    const availableWidth = Math.max(pdfCanvasShell.clientWidth - 36, 280);
                    const displayScale = Math.min(1.75, Math.max(0.7, availableWidth / baseViewport.width));
                    const outputScale = Math.min(window.devicePixelRatio || 1, 2);
                    const displayViewport = page.getViewport({ scale: displayScale });
                    const displayWidth = Math.floor(displayViewport.width);
                    const displayHeight = Math.floor(displayViewport.height);
                    const context = pdfCanvas.getContext('2d', { alpha: false });

                    if (!context) {
                        throw new Error('Canvas is unavailable.');
                    }

                    pdfCanvas.width = Math.ceil(displayViewport.width * outputScale);
                    pdfCanvas.height = Math.ceil(displayViewport.height * outputScale);
                    pdfCanvas.style.width = `${displayWidth}px`;
                    pdfCanvas.style.height = `${displayHeight}px`;
                    pdfPageStage.style.width = `${displayWidth}px`;
                    pdfPageStage.style.height = `${displayHeight}px`;
                    pdfTextLayer.style.width = `${displayWidth}px`;
                    pdfTextLayer.style.height = `${displayHeight}px`;
                    pdfTextLayer.style.setProperty('--total-scale-factor', String(displayViewport.scale));
                    pdfTextLayer.replaceChildren();
                    // Canvas uses a high-DPI transform while TextLayer keeps the same viewport as the visible page.
                    // This keeps text selection coordinates aligned with the rendered PDF at every display scale.
                    const renderTask = page.render({
                        canvasContext: context,
                        transform: outputScale === 1 ? null : [outputScale, 0, 0, outputScale, 0, 0],
                        viewport: displayViewport
                    });
                    pdfRenderTask = renderTask;
                    await renderTask.promise;

                    if (renderId !== pdfRenderId) {
                        return;
                    }

                    pdfRenderTask = null;
                    currentPdfPage = normalisedPage;
                    pdfPagePosition.textContent = `Page ${normalisedPage} of ${documentProxy.numPages}`;
                    previousPdfPage.disabled = normalisedPage <= 1;
                    nextPdfPage.disabled = normalisedPage >= documentProxy.numPages;
                    try {
                        const renderedTextLayer = await renderPdfTextLayer(page, displayViewport, renderId);
                        if (renderedTextLayer) {
                            pdfPreviewStatus.textContent = 'Select text in the preview to translate it.';
                        }
                    } catch {
                        pdfTextLayer.replaceChildren();
                        pdfPreviewStatus.textContent = 'Preview loaded, but selectable text is unavailable on this page.';
                    }
                } catch {
                    if (renderId === pdfRenderId) {
                        pdfRenderTask = null;
                        pdfPreviewStatus.textContent = 'Preview is unavailable for this PDF.';
                    }
                }
            }

            function goToPdfPage(pageNumber) {
                if (!isPdfPreviewActive) {
                    return;
                }

                const segmentIndex = importedSegments.findIndex(segment => segment.sourcePage === pageNumber);
                if (segmentIndex >= 0 && segmentIndex !== currentSegmentIndex) {
                    syncCurrentFileSegment();
                    currentSegmentIndex = segmentIndex;
                    renderCurrentSegment();
                    return;
                }

                void renderPdfPage(pageNumber);
            }

            function workspaceResizeBounds() {
                const minimum = 440;
                const maximum = Math.max(minimum + 120, Math.floor(window.innerHeight * 0.78));
                return { minimum, maximum };
            }

            function resizeWorkspace(height) {
                const { minimum, maximum } = workspaceResizeBounds();
                const nextHeight = Math.min(Math.max(Math.round(height), minimum), maximum);
                workspaceGrid.style.height = `${nextHeight}px`;
            }

            function expandImportedWorkspace() {
                if (!window.matchMedia('(min-width: 901px) and (min-height: 820px)').matches || workspaceGrid.style.height) {
                    return;
                }

                resizeWorkspace(window.innerHeight * 0.68);
            }

            function beginWorkspaceResize(event) {
                if (event.button !== undefined && event.button !== 0) {
                    return;
                }

                event.preventDefault();
                workspaceResizeState = {
                    pointerId: event.pointerId,
                    startHeight: workspaceGrid.getBoundingClientRect().height,
                    startY: event.clientY
                };
                workspaceResizeHandle.setPointerCapture(event.pointerId);
            }

            function resizeWorkspaceFromPointer(event) {
                if (!workspaceResizeState || workspaceResizeState.pointerId !== event.pointerId) {
                    return;
                }

                resizeWorkspace(workspaceResizeState.startHeight + event.clientY - workspaceResizeState.startY);
            }

            function endWorkspaceResize(event) {
                if (!workspaceResizeState || workspaceResizeState.pointerId !== event.pointerId) {
                    return;
                }

                workspaceResizeHandle.releasePointerCapture(event.pointerId);
                workspaceResizeState = null;
            }

            function resizeWorkspaceFromKeyboard(event) {
                const currentHeight = workspaceGrid.getBoundingClientRect().height;
                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    resizeWorkspace(currentHeight - 48);
                } else if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    resizeWorkspace(currentHeight + 48);
                } else if (event.key === 'Home') {
                    event.preventDefault();
                    resizeWorkspace(workspaceResizeBounds().minimum);
                } else if (event.key === 'End') {
                    event.preventDefault();
                    resizeWorkspace(workspaceResizeBounds().maximum);
                }
            }

            function setSelectedFile(file) {
                resetPendingFile();

                if (!file) {
                    return;
                }

                const extension = getFileExtension(file.name);
                if (extension !== 'txt' && extension !== 'docx' && extension !== 'pdf') {
                    showFileImportMessage('Supported file types: TXT, DOCX, and PDF.', true);
                    return;
                }

                if (file.size > maxUploadBytes) {
                    showFileImportMessage(`The file is larger than the ${maxUploadSizeLabel} import limit.`, true);
                    return;
                }

                selectedFile = file;
                fileSelectionName.textContent = file.name;
                fileSelectionName.hidden = false;
                importFile.disabled = false;
                showFileImportMessage('');
            }

            function removeDropState() {
                fileDropDepth = 0;
                fileDropZone.classList.remove('is-dragging');
            }

            function resetImportedFile() {
                resetPendingFile();
                removeDropState();
                resetPdfPreview();
                importedSegments = [];
                importedPageCount = null;
                currentSegmentIndex = 0;
                clearReplacementHistories();
                fileText.value = '';
                fileText.hidden = false;
                fileEditor.classList.remove('is-split-view');
                fileViewToggle.hidden = true;
                fileEditor.hidden = true;
                fileUpload.hidden = false;
                showFileImportMessage('');
                resetSelectionState();
            }

            async function openSelectedFile() {
                const file = selectedFile;
                if (!file) {
                    return;
                }

                importFile.disabled = true;
                importFile.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';
                showFileImportMessage('');

                try {
                    const body = new FormData();
                    body.append('file', file);

                    const response = await fetch(fileImportEndpoint, {
                        method: 'POST',
                        headers: { RequestVerificationToken: antiForgeryToken },
                        body
                    });
                    const result = await response.json().catch(() => ({}));

                    if (!response.ok || !Array.isArray(result.segments) || result.segments.length === 0) {
                        const fallbackMessage = response.status === 413
                            ? `The file is larger than the ${maxUploadSizeLabel} import limit.`
                            : 'The file could not be imported.';
                        showFileImportMessage(result.message || fallbackMessage, true);
                        return;
                    }

                    clearReplacementHistories();
                    importedSegments = result.segments;
                    importedPageCount = Number.isInteger(result.pageCount) ? result.pageCount : null;
                    currentSegmentIndex = 0;
                    importedFileName.textContent = result.fileName || file.name;
                    resetPdfPreview();
                    importedPdfFile = isPdfFile(file) ? file : null;
                    fileViewToggle.hidden = importedPdfFile === null;
                    fileText.hidden = false;
                    resetPendingFile();
                    fileUpload.hidden = true;
                    fileEditor.hidden = false;
                    expandImportedWorkspace();
                    setFileView(importedPdfFile && canUseSplitFileView() ? 'split' : 'text');
                    renderCurrentSegment();
                } catch {
                    showFileImportMessage('The file could not be imported. Please try again.', true);
                } finally {
                    importFile.disabled = !selectedFile;
                    importFile.innerHTML = '<i class="bi bi-file-earmark-text me-2"></i>Open text';
                }
            }

            function selectDroppedFile(event) {
                event.preventDefault();
                removeDropState();

                const files = Array.from(event.dataTransfer?.files ?? []);
                if (files.length !== 1) {
                    resetPendingFile();
                    showFileImportMessage('Drop one TXT, DOCX, or PDF file at a time.', true);
                    return;
                }

                setSelectedFile(files[0]);
            }

            function handleFileInputChange() {
                setSelectedFile(fileInput.files?.[0] ?? null);
            }

            function beginDropState(event) {
                event.preventDefault();
                fileDropDepth++;
                fileDropZone.classList.add('is-dragging');
            }

            function updateDropState(event) {
                event.preventDefault();
                event.dataTransfer.dropEffect = 'copy';
                fileDropZone.classList.add('is-dragging');
            }

            function leaveDropZone(event) {
                event.preventDefault();
                fileDropDepth--;
                if (fileDropDepth <= 0) {
                    removeDropState();
                }
            }

            function preventFileDrop(event) {
                event.preventDefault();
            }

            function handleUndoRedoShortcut(event) {
                if (document.activeElement !== activeTextArea() || event.altKey || !(event.ctrlKey || event.metaKey)) {
                    return;
                }

                const key = event.key.toLowerCase();
                const direction = key === 'y' || (key === 'z' && event.shiftKey)
                    ? 'redo'
                    : key === 'z'
                        ? 'undo'
                        : null;

                if (direction && applyReplacementHistory(direction)) {
                    event.preventDefault();
                }
            }

            document.querySelectorAll('[data-submit-action]').forEach(button => {
                button.addEventListener('click', () => {
                    submitAction.value = button.dataset.submitAction;
                });
            });

            document.querySelectorAll('[data-workspace-tab]').forEach(button => {
                button.addEventListener('click', () => setActiveWorkspace(button.dataset.workspaceTab));
            });

            fileViewButtons.forEach(button => {
                button.addEventListener('click', () => {
                    hidePdfSelectionPopover(true);
                    setFileView(button.dataset.fileView);
                });
            });

            workspaceResizeHandle.addEventListener('pointerdown', beginWorkspaceResize);
            workspaceResizeHandle.addEventListener('pointermove', resizeWorkspaceFromPointer);
            workspaceResizeHandle.addEventListener('pointerup', endWorkspaceResize);
            workspaceResizeHandle.addEventListener('pointercancel', endWorkspaceResize);
            workspaceResizeHandle.addEventListener('keydown', resizeWorkspaceFromKeyboard);

            historyToggle.addEventListener('click', () => setHistoryOpen(historyPanel.hidden));
            historyClose.addEventListener('click', () => setHistoryOpen(false));

            form?.addEventListener('submit', event => {
                submitAction.value = event.submitter?.dataset.submitAction || submitAction.value || 'translate';
                translateButton.disabled = true;
                translateButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>';
            });

            [sampleText, fileText].forEach(textArea => {
                textArea.addEventListener('select', scheduleSelectionTranslation);
                textArea.addEventListener('keyup', scheduleSelectionTranslation);
                textArea.addEventListener('mouseup', scheduleSelectionTranslation);
                textArea.addEventListener('input', handleWorkspaceTextInput);
            });

            selectAllText.addEventListener('click', () => {
                const textArea = activeTextArea();
                if (!textArea.value.trim()) {
                    setSelectionStatus(activeWorkspace === 'file' ? 'Choose a file first.' : 'No text to select.');
                    return;
                }

                textArea.focus();
                textArea.select();
                translateSelection(true);
            });

            pasteText.addEventListener('click', pasteFromClipboard);
            clearText.addEventListener('click', clearCurrentText);
            resetSample.addEventListener('click', () => {
                sampleText.value = defaultSampleText;
                clearCurrentReplacementHistory();
                resetSelectionState();
            });

            fileInput.addEventListener('change', handleFileInputChange);
            fileDropZone.addEventListener('dragenter', beginDropState);
            fileDropZone.addEventListener('dragover', updateDropState);
            fileDropZone.addEventListener('dragleave', leaveDropZone);
            fileDropZone.addEventListener('drop', selectDroppedFile);
            fileDropZone.addEventListener('dragend', removeDropState);
            document.addEventListener('dragover', preventFileDrop);
            document.addEventListener('drop', preventFileDrop);
            document.addEventListener('keydown', handleUndoRedoShortcut);
            importFile.addEventListener('click', openSelectedFile);
            undoReplacement.addEventListener('click', () => applyReplacementHistory('undo'));
            redoReplacement.addEventListener('click', () => applyReplacementHistory('redo'));
            previousSegment.addEventListener('click', () => {
                if (currentSegmentIndex > 0) {
                    syncCurrentFileSegment();
                    currentSegmentIndex--;
                    renderCurrentSegment();
                }
            });
            nextSegment.addEventListener('click', () => {
                if (currentSegmentIndex < importedSegments.length - 1) {
                    syncCurrentFileSegment();
                    currentSegmentIndex++;
                    renderCurrentSegment();
                }
            });
            clearFile.addEventListener('click', resetImportedFile);
            previousPdfPage.addEventListener('click', () => goToPdfPage(currentPdfPage - 1));
            nextPdfPage.addEventListener('click', () => goToPdfPage(currentPdfPage + 1));
            pdfTextLayer.addEventListener('mousedown', beginPdfPointerSelection);
            document.addEventListener('mousemove', updatePdfPointerSelection);
            pdfTextLayer.addEventListener('keyup', event => {
                if (event.key === 'Shift' || event.key.startsWith('Arrow')) {
                    schedulePdfSelectionPopover();
                }
            });
            translatePdfSelectionButton.addEventListener('click', translatePdfSelection);
            copyPdfSelectionButton.addEventListener('click', async () => {
                const copied = await copyText(activePdfSelectionText);
                pdfPreviewStatus.textContent = copied ? 'Selected text copied.' : 'Copy is unavailable. Select the text and use Ctrl+C.';
            });
            closePdfSelectionButton.addEventListener('click', () => hidePdfSelectionPopover(true));
            pdfCanvasShell.addEventListener('scroll', () => hidePdfSelectionPopover());
            document.addEventListener('selectionchange', () => {
                const hasPopoverFocus = pdfSelectionPopover.contains(document.activeElement);
                if (!getPdfTextSelection() && !hasPopoverFocus) {
                    hidePdfSelectionPopover();
                }
            });
            document.addEventListener('mouseup', finishPdfPointerSelection);
            window.addEventListener('resize', () => {
                hidePdfSelectionPopover();
                window.clearTimeout(pdfResizeTimer);
                if (fileEditor.classList.contains('is-split-view') && !canUseSplitFileView()) {
                    setFileView('text');
                }
                if (!isPdfPreviewActive) {
                    return;
                }

                pdfResizeTimer = window.setTimeout(() => void renderPdfPage(currentPdfPage), 160);
            });

            clearHistory.addEventListener('click', () => {
                localStorage.removeItem(historyKey);
                renderHistory();
            });

            copyTranslation.addEventListener('click', () => {
                if (translatedText.value.trim()) {
                    navigator.clipboard?.writeText(translatedText.value);
                }
            });

            if (initialInput && initialOutput) {
                addHistory(initialInput, initialOutput, @Json.Serialize(Model.DetectedLanguage));
            }

            resetSample.hidden = false;
            setHistoryOpen(false);
            updateUndoRedoControls();
            renderHistory();
        })();
    </script>
}
