@using TranslatorAzure.Models.Translator
@inject Microsoft.Extensions.Options.IOptions<TranslatorAzure.Services.FileText.FileTextImportOptions> FileTextOptions
@model TranslatorAzure.Models.Translator.TranslatorViewModel

@{
    ViewData["Title"] = "Azure Translator";

    const string autoCode = TranslatorFormModel.AutoDetectLanguageCode;
    string selectedFrom = Model.FormModel?.LanguageFrom ?? autoCode;
    string selectedTo = Model.FormModel?.LanguageTo ?? "uk";
    string sourceText = string.IsNullOrWhiteSpace(Model.FormModel?.Text)
        ? "Hello, how are you today?"
        : Model.FormModel.Text;

    string workspaceSampleText = @"Test Example Text:
Garbage collection in .NET

Every object created in managed code is tracked by the CLR garbage collector. Most ordinary allocations begin on the small object heap; very large objects use the large object heap, and explicitly pinned allocations can use the pinned object heap. These are different allocation regions, not different ownership rules: the collector still determines whether each managed object can be reached by the application.

Creating a small object is intentionally cheap. The runtime normally advances an allocation pointer instead of searching for a suitable free block. That makes allocation fast, but the heap must occasionally be collected before more space can be reserved.

A collection begins with roots: local variables on thread stacks, static fields, CPU registers, and runtime handles. The runtime follows references from those roots. Every object it can reach is live; an object outside that graph is garbage and its memory can be reused.

New allocations start in generation 0 because most objects are short-lived. Survivors can be promoted to generation 1 and then generation 2. Collecting a young generation examines a smaller part of the heap, while a generation 2 collection is broader and normally more expensive.

After a collection, movable live objects can be compacted into a contiguous block, and the runtime updates the references to them. Pinned objects cannot move, so long-lived pinning can make compaction less effective.

GC releases managed memory. It does not close file handles, database connections, or network streams; those resources still need deterministic cleanup through IDisposable and using.";

    var sourceLanguageInfo = selectedFrom == autoCode
        ? null
        : Model.TranslatorLanguages.translation.GetValueOrDefault(selectedFrom);
    var targetLanguageInfo = Model.TranslatorLanguages.translation.GetValueOrDefault(selectedTo);

    string textDirectionFrom = sourceLanguageInfo?.dir ?? "ltr";
    string textDirectionTo = targetLanguageInfo?.dir ?? "ltr";

    string LanguageLabel(KeyValuePair<string, LanguageInfo> language)
    {
        var info = language.Value;
        return info.name == info.nativeName
            ? info.name
            : $"{info.name} ({info.nativeName})";
    }

    var maxUploadBytes = FileTextOptions.Value.MaxUploadBytes;
    var maxUploadSizeLabel = FileTextOptions.Value.MaxUploadSizeLabel;

    var translatorPageConfig = new
    {
        historyKey = "azure-translator-history-v1",
        historyLimit = 20,
        maxSelectionLength = TranslationRequest.MaxTextLength,
        maxUploadBytes,
        maxUploadSizeLabel,
        translateEndpoint = Url.Action("Translate", "Translator"),
        speechEndpoint = Url.Action("Speech", "Translator"),
        fileImportEndpoint = Url.Action("Import", "FileText"),
        pdfJsModuleUrl = Url.Content("~/lib/pdfjs/pdf.min.mjs"),
        pdfWorkerUrl = Url.Content("~/lib/pdfjs/pdf.worker.min.mjs"),
        initialInput = Model.FormModel?.Text ?? string.Empty,
        initialOutput = Model.Translation ?? string.Empty,
        detectedLanguage = Model.DetectedLanguage
    };
}

<section class="translator-shell">
    <h1 class="visually-hidden">Azure Translator</h1>

    <form id="translator-form" class="translation-surface" method="post" asp-controller="Translator" asp-action="Index">
        @Html.AntiForgeryToken()
        <input type="hidden" id="submit-action" name="btn" value="translate" />
        <input type="hidden" name="detected-lang" value="@Model.DetectedLanguage" />
        <div class="translator-grid">
            <div class="translator-pane">
                <label class="form-label" for="source-language">Source</label>
                <select id="source-language" name="lang-from" class="form-select" aria-label="Source language">
                    <option value="@autoCode" selected="@(selectedFrom == autoCode ? "selected" : null)">Auto-detect</option>
                    @foreach (var lang in Model.TranslatorLanguages.translation)
                    {
                        var textDirectionClass = lang.Value.dir == "ltr" ? "ltr-text" : "rtl-text";

                        <option
                            value="@lang.Key"
                            class="@textDirectionClass"
                            selected="@(lang.Key == selectedFrom ? "selected" : null)">
                            @LanguageLabel(lang)
                        </option>
                    }
                </select>

                <div class="translation-textarea-shell translation-textarea-shell--source">
                    <textarea
                        id="source-text"
                        name="text"
                        class="form-control translator-textarea translator-textarea--source @(textDirectionFrom == "ltr" ? "ltr-text" : "rtl-text")"
                        rows="7">@sourceText</textarea>
                    <div class="translation-overlay-actions">
                        <button
                            id="speak-source"
                            class="btn btn-outline-secondary icon-button speech-button"
                            type="button"
                            title="Listen to source"
                            aria-label="Listen to source">
                            <i class="bi bi-volume-up"></i>
                        </button>
                    </div>
                </div>

                <div class="translator-meta">
                    @if (Model.DetectedLanguage != null)
                    {
                        <span>
                            Detected:
                            @Model.DetectedLanguage
                            @if (Model.DetectionScore != null)
                            {
                                <span>(@Math.Round(Model.DetectionScore.Value * 100)%)</span>
                            }
                        </span>
                    }
                @if (Model.TransliterationFrom != null)
                {
                    <span class="translator-transliteration" title="Transliteration">[@Model.TransliterationFrom]</span>
                }
                </div>
            </div>

            <div class="translator-actions">
                <button
                    class="btn btn-outline-secondary icon-button"
                    type="submit"
                    data-submit-action="switch"
                    title="Switch languages"
                    aria-label="Switch languages">
                    <i class="bi bi-arrow-left-right"></i>
                </button>
                <button
                    id="translate-button"
                    class="btn btn-primary icon-button translate-button"
                    type="submit"
                    data-submit-action="translate"
                    title="Translate"
                    aria-label="Translate">
                    <i class="bi bi-translate"></i>
                </button>
            </div>

            <div class="translator-pane">
                <label class="form-label" for="target-language">Target</label>
                <select id="target-language" name="lang-to" class="form-select" aria-label="Target language">
                    @foreach (var lang in Model.TranslatorLanguages.translation)
                    {
                        var textDirectionClass = lang.Value.dir == "ltr" ? "ltr-text" : "rtl-text";

                        <option
                            value="@lang.Key"
                            class="@textDirectionClass"
                            selected="@(lang.Key == selectedTo ? "selected" : null)">
                            @LanguageLabel(lang)
                        </option>
                    }
                </select>

                <div class="translation-textarea-shell translation-textarea-shell--target">
                    <textarea
                        id="translated-text"
                        name="translation"
                        class="form-control translator-textarea translator-textarea--target @(textDirectionTo == "ltr" ? "ltr-text" : "rtl-text")"
                        rows="7"
                        placeholder="Translation will appear here"
                        readonly>@Model.Translation</textarea>
                    <div class="translation-overlay-actions">
                        <button
                            id="speak-target"
                            class="btn btn-outline-secondary icon-button speech-button"
                            type="button"
                            title="Listen to translation"
                            aria-label="Listen to translation">
                            <i class="bi bi-volume-up"></i>
                        </button>
                        <button
                            id="copy-translation"
                            class="btn btn-outline-secondary icon-button copy-button"
                            type="button"
                            title="Copy translation"
                            aria-label="Copy translation">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                </div>

                <div class="translator-meta">
                    @if (Model.ErrorMessage != null)
                    {
                        <span class="translator-error">
                            <i class="bi bi-exclamation-circle"></i>
                            @Model.ErrorMessage
                        </span>
                    }
                @if (Model.TransliterationTo != null)
                {
                    <span class="translator-transliteration" title="Transliteration">[@Model.TransliterationTo]</span>
                }
                </div>
            </div>
        </div>
    </form>

    <div class="workspace-grid">
        <section class="document-panel" aria-label="Text workspace">
            <div class="panel-toolbar">
                <div class="workspace-tabs" role="tablist" aria-label="Workspace type">
                    <button class="workspace-tab is-active" type="button" role="tab" aria-selected="true" data-workspace-tab="sample">Text editor</button>
                    <button class="workspace-tab" type="button" role="tab" aria-selected="false" data-workspace-tab="file">Imported file</button>
                </div>

                <div class="panel-controls" aria-label="Editor controls">
                    <div class="toolbar-group toolbar-group--selection" aria-label="Selected text action">
                        <span class="selection-mode-label">
                            <span>Selected text</span>
                        </span>
                        <span class="visually-hidden" id="selection-mode-label">Selected text action</span>
                        <div class="selection-mode-switch" role="radiogroup" aria-labelledby="selection-mode-label">
                            <input class="selection-mode-input visually-hidden" type="radio" name="selection-mode" id="translate-selected" value="translate" checked>
                            <input class="selection-mode-input visually-hidden" type="radio" name="selection-mode" id="replace-selected" value="replace">
                            <span class="selection-mode-indicator" aria-hidden="true"></span>
                            <label class="selection-mode-option" for="translate-selected" title="Show selected text translation in a floating panel">
                                <i class="bi bi-translate" aria-hidden="true"></i>
                                <span>Translate</span>
                            </label>
                            <label class="selection-mode-option" for="replace-selected" title="Replace selected text with translation">
                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                <span>Replace</span>
                            </label>
                        </div>
                    </div>
                    <div class="toolbar-group">
                        <button id="paste-text" class="btn toolbar-command-button" type="button" title="Paste text from clipboard" aria-label="Paste text from clipboard">
                            <i class="bi bi-clipboard-plus"></i>
                            <span>Paste</span>
                        </button>
                        <button id="clear-text" class="btn toolbar-command-button" type="button" title="Clear current text" aria-label="Clear current text">
                            <i class="bi bi-eraser"></i>
                            <span>Clear</span>
                        </button>
                    </div>
                    <div class="toolbar-group toolbar-group--actions" aria-label="Text actions">
                        <button id="select-all-text" class="btn toolbar-command-button" type="button" title="Select all text in the current section" aria-label="Select all text in the current section">
                            <i class="bi bi-text-paragraph"></i>
                            <span>Select all</span>
                        </button>
                        <div class="toolbar-icon-cluster" role="group" aria-label="Replacement history">
                            <button id="undo-replacement" class="btn toolbar-icon-button" type="button" title="Undo replacement (Ctrl+Z)" aria-label="Undo replacement" disabled>
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button id="redo-replacement" class="btn toolbar-icon-button" type="button" title="Redo replacement (Ctrl+Y)" aria-label="Redo replacement" disabled>
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <button id="reset-sample" class="btn toolbar-command-button toolbar-command-button--restore" type="button" title="Restore the default example text" aria-label="Restore the default example text">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>Restore text</span>
                        </button>
                    </div>
                </div>
                <span id="selection-status" class="selection-status" role="status"></span>
            </div>

            <div id="sample-workspace" class="workspace-content">
                <textarea id="sample-text" class="document-textarea" spellcheck="true" placeholder="Write or paste text here">@workspaceSampleText</textarea>
                <p class="editor-helper"><i class="bi bi-pencil-square" aria-hidden="true"></i>Type or paste your own text here.</p>
            </div>

            <div id="file-workspace" class="workspace-content" hidden>
                <div id="file-upload" class="file-upload">
                    <label id="file-drop-zone" class="file-drop-zone">
                        <input id="file-input" class="visually-hidden" type="file" accept=".txt,.docx,.pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/pdf" />
                        <span class="file-upload-icon"><i class="bi bi-file-earmark-arrow-up"></i></span>
                        <strong>Choose or drop a file</strong>
                        <span class="file-upload-types">TXT, DOCX, PDF - up to @maxUploadSizeLabel</span>
                        <span class="file-upload-note">PDF: selectable text only. Scans and image-only files are not supported.</span>
                    </label>
                    <div class="file-selection-row">
                        <span id="file-selection-name" class="file-selection-name" hidden></span>
                        <button id="import-file" class="btn btn-primary" type="button" disabled>
                            <i class="bi bi-file-earmark-text me-2"></i>Open text
                        </button>
                    </div>
                </div>

                <div id="file-editor" class="file-editor" hidden>
                    <div class="file-editor-header">
                        <span id="imported-file-name" class="imported-file-name"></span>
                        <div class="file-editor-actions">
                            <div id="file-view-toggle" class="file-view-toggle" role="tablist" aria-label="PDF view" hidden>
                                <button class="file-view-button is-active" type="button" role="tab" aria-selected="true" data-file-view="text">Text</button>
                                <button class="file-view-button" type="button" role="tab" aria-selected="false" data-file-view="preview">Original PDF</button>
                                <button class="file-view-button file-view-button--split" type="button" role="tab" aria-selected="false" data-file-view="split" title="Show text and the original PDF side by side">Split</button>
                            </div>
                            <div class="file-segment-navigation" aria-label="File section navigation">
                                <button id="previous-segment" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Previous section" aria-label="Previous section">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span id="segment-position"></span>
                                <button id="next-segment" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Next section" aria-label="Next section">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <button id="clear-file" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Close imported file" aria-label="Close imported file">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="file-editor-body">
                        <textarea id="file-text" class="document-textarea" spellcheck="true"></textarea>
                        <div id="pdf-preview" class="pdf-preview" hidden>
                            <div class="pdf-preview-toolbar">
                                <div class="pdf-page-navigation" aria-label="PDF page navigation">
                                    <button id="previous-pdf-page" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Previous PDF page" aria-label="Previous PDF page">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                    <span id="pdf-page-position">Page 1</span>
                                    <button id="next-pdf-page" class="btn btn-outline-secondary toolbar-icon-button" type="button" title="Next PDF page" aria-label="Next PDF page">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </div>
                                <span id="pdf-preview-status" class="pdf-preview-status" role="status"></span>
                            </div>
                            <div id="pdf-canvas-shell" class="pdf-canvas-shell">
                                <div id="pdf-page-stage" class="pdf-page-stage">
                                    <canvas id="pdf-canvas"></canvas>
                                    <div id="pdf-text-layer" class="pdf-text-layer textLayer" aria-label="Selectable text in PDF preview"></div>
                                </div>
                            </div>
                            <div id="pdf-selection-popover" class="pdf-selection-popover" role="dialog" aria-label="Selected PDF text" hidden>
                                <div class="pdf-selection-actions" role="toolbar" aria-label="Selected text actions">
                                    <span id="pdf-selection-card-title" class="pdf-selection-card-title" hidden>Translation</span>
                                    <span class="pdf-selection-drag-cue" aria-hidden="true">
                                        <i class="bi bi-grip-horizontal"></i>
                                    </span>
                                    <button id="translate-pdf-selection" class="btn btn-primary pdf-selection-translate" type="button">
                                        <i class="bi bi-translate" aria-hidden="true"></i>
                                        <span>Translate</span>
                                    </button>
                                    <button id="copy-pdf-selection" class="btn toolbar-icon-button" type="button" title="Copy selected text" aria-label="Copy selected text">
                                        <i class="bi bi-copy" aria-hidden="true"></i>
                                    </button>
                                    <button id="expand-pdf-selection" class="btn toolbar-icon-button pdf-selection-expand" type="button" title="Expand translation" aria-label="Expand translation" aria-expanded="false">
                                        <i class="bi bi-arrows-angle-expand" aria-hidden="true"></i>
                                    </button>
                                    <button id="reset-pdf-selection-layout" class="btn toolbar-icon-button" type="button" title="Restore default card size and position" aria-label="Restore default card size and position" hidden>
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                    </button>
                                    <button id="close-pdf-selection" class="btn toolbar-icon-button" type="button" title="Close selected text actions" aria-label="Close selected text actions">
                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <p id="pdf-selection-source" class="pdf-selection-source" hidden></p>
                                <p id="pdf-selection-result" class="pdf-selection-result" role="status" hidden></p>
                            </div>
                            <p class="pdf-preview-note"><i class="bi bi-info-circle" aria-hidden="true"></i>Preview keeps the original layout and images. Text selection and translation work only where the PDF contains selectable text.</p>
                        </div>
                    </div>
                </div>

                <p id="file-import-message" class="file-import-message" role="status" hidden></p>
            </div>
            <div id="workspace-resize-handle" class="workspace-resize-handle" role="separator" aria-label="Resize workspace height" aria-orientation="horizontal" tabindex="0">
                <span aria-hidden="true"></span>
            </div>
        </section>

        <aside id="history-panel" class="history-panel" aria-label="Translation history" hidden>
            <div class="history-header">
                <h2>History</h2>
                <div class="history-actions">
                    <button id="clear-history" class="btn toolbar-icon-button" type="button" title="Clear history" aria-label="Clear history">
                        <i class="bi bi-trash3"></i>
                    </button>
                    <button id="history-close" class="btn toolbar-icon-button" type="button" title="Close history" aria-label="Close history">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            <div id="translation-history" class="history-list"></div>
        </aside>
    </div>
</section>

<div id="selection-translation-panel" class="selection-translation-panel" role="dialog" aria-label="Selection translation" hidden>
    <div id="selection-translation-header" class="selection-translation-panel__header" title="Drag to move">
        <span class="selection-translation-panel__drag-cue" aria-hidden="true">
            <i class="bi bi-grip-horizontal"></i>
        </span>
        <span class="selection-translation-panel__title">
            <i class="bi bi-translate" aria-hidden="true"></i>
            <span>Selection translation</span>
        </span>
        <span class="selection-translation-panel__time" id="selection-translation-time"></span>
        <div class="selection-translation-panel__actions">
            <button id="copy-selection-translation" class="btn toolbar-icon-button" type="button" title="Copy translation" aria-label="Copy translation">
                <i class="bi bi-copy" aria-hidden="true"></i>
            </button>
            <button id="reset-selection-translation-panel" class="btn toolbar-icon-button" type="button" title="Restore default panel size and position" aria-label="Restore default panel size and position">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            </button>
            <button id="close-selection-translation-panel" class="btn toolbar-icon-button" type="button" title="Close translation" aria-label="Close translation">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <div class="selection-translation-panel__body">
        <p id="selection-translation-result" class="selection-translation-panel__result" role="status"></p>
    </div>
</div>

<div class="notification-toast-container position-fixed top-0 end-0 mt-4 me-4">
    <div id="notification-toast" class="toast notification-toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <span id="notification-toast-icon" class="notification-toast__icon me-2">
                <i class="bi bi-exclamation-circle"></i>
            </span>
            <strong class="me-auto" id="notification-toast-title">Notice</strong>
            <small class="text-muted" id="notification-toast-time"></small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body" id="notification-toast-body"></div>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="translator-page-config">
        @Json.Serialize(translatorPageConfig)
    </script>
    <script type="module" src="~/js/translator/index.js" asp-append-version="true"></script>
}
