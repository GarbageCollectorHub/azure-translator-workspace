{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileText": {
    "MaxUploadBytes": 2097152,
    "MaxPdfPages": 50,
    "MaxExtractedCharacters": 250000
  },
  "RateLimiting": {
    "TranslationPermitLimit": 20,
    "TranslationWindowSeconds": 60,
    "GlobalTranslationPermitLimit": 60,
    "GlobalTranslationWindowSeconds": 60,
    "FileImportPermitLimit": 6,
    "FileImportWindowSeconds": 60,
    "GlobalFileImportPermitLimit": 20,
    "GlobalFileImportWindowSeconds": 60
  },
  "AllowedHosts": "*"
}
