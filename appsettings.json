{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileText": {
    "MaxUploadBytes": 2097152,
    "MaxPdfPages": 50,
    "MaxExtractedCharacters": 250000
  },
  "RateLimiting": {
    "TranslationPermitLimit": 20,
    "TranslationWindowSeconds": 60,
    "GlobalTranslationPermitLimit": 60,
    "GlobalTranslationWindowSeconds": 60,
    "FileImportPermitLimit": 6,
    "FileImportWindowSeconds": 60,
    "GlobalFileImportPermitLimit": 20,
    "GlobalFileImportWindowSeconds": 60,
    "SpeechSynthesisPermitLimit": 12,
    "SpeechSynthesisWindowSeconds": 60,
    "GlobalSpeechSynthesisPermitLimit": 40,
    "GlobalSpeechSynthesisWindowSeconds": 60,
    "FeedbackPermitLimit": 3,
    "FeedbackWindowSeconds": 600,
    "GlobalFeedbackPermitLimit": 20,
    "GlobalFeedbackWindowSeconds": 600
  },
  "SpeechSynthesis": {
    "Endpoint": "",
    "OutputFormat": "audio-24khz-96kbitrate-mono-mp3",
    "MaxTextLength": 5000,
    "ClientMonthlyCharacterLimit": 50000,
    "GlobalMonthlyCharacterLimit": 0
  },
  "AllowedHosts": "*"
}
