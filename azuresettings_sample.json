{
  "translator": {
    "key": "<your-translator-key>",
    "endpoint": "https://api.cognitive.microsofttranslator.com",
    "location": "<YOUR-RESOURCE-LOCATION>",
    "route": "/translate?api-version=3.0",
    "routeTransliterate": "/transliterate?api-version=3.0",
    "languagesUrl": "https://api.cognitive.microsofttranslator.com/languages?api-version=3.0"
  },
  "cosmos": {
    "connectionString": "<your-cosmos-db-connection-string>",
    "databaseName": "TranslatorAzure",
    "containerName": "VisitProfiles"
  },
  "analytics": {
    "enabled": true,
    "ipHashSalt": "<your-private-ip-hash-salt>",
    "visitCooldownMinutes": 30,
    "visitorCookieDays": 180,
    "geoIpEnabled": true,
    "ignoreToken": "<your-analytics-ignore-token>"
  },
  "SpeechSynthesis": {
    "enabled": true,
    "key": "<your-speech-key>",
    "region": "<YOUR-SPEECH-RESOURCE-REGION>",
    "endpoint": "https://<your-speech-resource-region>.api.cognitive.microsoft.com/",
    "outputFormat": "audio-24khz-96kbitrate-mono-mp3",
    "maxTextLength": 5000,
    "clientMonthlyCharacterLimit": 50000,
    "globalMonthlyCharacterLimit": 0
  },
  "Feedback": {
    "enabled": true,
    "smtpHost": "smtp.gmail.com",
    "smtpPort": 587,
    "useStartTls": true,
    "senderEmail": "<your-pet-project-email@gmail.com>",
    "senderName": "Azure Translator Workspace",
    "recipientEmail": "<where-feedback-should-arrive@example.com>",
    "smtpUserName": "<your-pet-project-email@gmail.com>",
    "smtpPassword": "<your-gmail-app-password>",
    "subject": "Azure Translator Workspace feedback",
    "minMessageLength": 5,
    "maxMessageLength": 2000,
    "sendTimeoutSeconds": 10,
    "queueCapacity": 100
  }
}
